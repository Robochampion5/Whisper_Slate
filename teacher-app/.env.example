# Whisper Slate Teacher App Environment Variables
# Copy this file to .env and fill in your values

# Backend API URL (include protocol and port)
# For LAN access, use the teacher laptop's LAN IP
# Example: VITE_API_URL=http://192.168.1.5:8000
VITE_API_URL=http://localhost:8000

# WebSocket URL (usually derived from VITE_API_URL by replacing http with ws)
# Example: VITE_WS_URL=ws://192.168.1.5:8000
# VITE_WS_URL=