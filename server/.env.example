# Whisper Slate Server Environment Variables
# Copy this file to .env and fill in your values

# Database
# SQLite (default) - file-based, no setup required
DATABASE_URL=sqlite:///./classroom.db
# For PostgreSQL: postgresql://user:password@localhost/whisper_slate

# JWT Authentication
# IMPORTANT: Use a strong random secret in production!
# Generate with: openssl rand -hex 32
JWT_SECRET=dev-secret-change-in-production

# Mock College IDs for MVP Authentication
# Format: COLLEGE_ID:PASSWORD (comma-separated)
# Example: AUTH_COLLEGE_IDS="student1:pass123,student2:pass456"
# In production, replace with real SSO (OAuth2/SAML)
AUTH_COLLEGE_IDS=

# CORS Origins (comma-separated)
# Default: localhost for development
# For LAN access: "http://192.168.1.5:5173,http://10.0.0.2:5173"
CORS_ORIGINS=http://localhost:5173

# OCR / Slide Enrichment
# Set to "true" to enable OCR on uploaded slides (requires tesseract installed)
OCR_ENABLED=false

# Enrichment Provider for topic extraction
# Options: "openai" | "local" (uses local model, no API key needed)
ENRICHMENT_PROVIDER=local

# OpenAI API Key (required if ENRICHMENT_PROVIDER=openai)
OPENAI_API_KEY=

# Optional: Custom port (default 8000)
# PORT=8000